VITE_API_URL=http://localhost:3000/api/v1

# Set to "true" to run the frontend fully against in-browser mock data (MSW) instead
# of a real backend — useful for demoing on Vercel before/without a live API deployed.
# See src/mocks/ for the mock handlers and demo accounts (all share the password
# Password123!, matching backend/prisma/seed.ts).
VITE_ENABLE_MOCKS=false
