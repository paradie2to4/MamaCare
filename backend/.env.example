# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Local dev / non-pooled providers: DIRECT_DATABASE_URL can be the same value as DATABASE_URL.
# Neon: DATABASE_URL is the pooled (PgBouncer, "-pooler") connection string the running app
# uses; DIRECT_DATABASE_URL is the unpooled one `prisma migrate` needs.
DATABASE_URL="postgresql://mamacare:change-me@localhost:5432/mamacare?schema=public"
DIRECT_DATABASE_URL="postgresql://mamacare:change-me@localhost:5432/mamacare?schema=public"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false

# RabbitMQ (not yet consumed in Phase 1 — reserved for Phase 2 reminder/follow-up events)
RABBITMQ_URL=amqp://mamacare:change-me@localhost:5672

# AI assistant — Anthropic API key. If left blank, the assistant falls back to a
# deterministic, knowledge-base-matched reply instead of calling the LLM.
AI_API_KEY=
AI_MODEL=claude-sonnet-5
