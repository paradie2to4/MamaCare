# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://mamacare:change-me@localhost:5432/mamacare?schema=public"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false

# RabbitMQ (not yet consumed in Phase 1 — reserved for Phase 2 reminder/follow-up events)
RABBITMQ_URL=amqp://mamacare:change-me@localhost:5672

# AI assistant (not yet consumed — reserved for Phase 3)
AI_API_KEY=
